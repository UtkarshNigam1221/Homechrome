# =============================================================================
# Handloom Admin API - Environment Configuration
# =============================================================================
# Copy this file to .env and modify as needed for local development
# For production, set these as environment variables or use AWS SSM/Secrets

# Application Configuration
APP_ENV=development
APP_DEBUG=true
QUOTE_VALIDITY_HRS=24

# Server Configuration
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s

# AWS Configuration
AWS_REGION=ap-south-1
# Leave empty for local development with DynamoDB Local
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
# For local development with DynamoDB Local (empty for AWS)
AWS_ENDPOINT=http://localhost:8000

# S3 Configuration (for asset storage)
AWS_S3_BUCKET=handloom-assets
# CDN URL for serving assets (CloudFront distribution URL)
AWS_CDN_URL=

# DynamoDB Table Names
DYNAMODB_CORE_TABLE=handloom-core
DYNAMODB_ORDERS_TABLE=handloom-orders
DYNAMODB_AUDIT_TABLE=handloom-audit
DYNAMODB_ANALYTICS_TABLE=handloom-analytics

# JWT Configuration
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ACCESS_TOKEN_DURATION=15m
JWT_REFRESH_TOKEN_DURATION=168h
JWT_ISSUER=handloom-admin

# CORS Configuration (comma-separated origins for production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# Default Admin Credentials (created by seed-data script)
# =============================================================================
# Email: admin@handloom.com
# Password: Admin@123!
#
# IMPORTANT: Change these credentials immediately after first login!

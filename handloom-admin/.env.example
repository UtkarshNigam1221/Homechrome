# =============================================================================
# Handloom Admin API - Environment Configuration
# =============================================================================
# Copy this file to .env and modify as needed for local development
# For production, set these as environment variables or use AWS SSM/Secrets

# Application Configuration
APP_ENV=development
APP_DEBUG=true
QUOTE_VALIDITY_HRS=24

# Server Configuration
SERVER_PORT=8081
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s

# AWS Configuration
AWS_REGION=ap-south-1
# Leave empty for local development with DynamoDB Local
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
# For local development with LocalStack (empty for AWS)
AWS_ENDPOINT=http://localhost:4566

# S3 Configuration (for asset storage)
AWS_S3_BUCKET=handloom-assets
# CDN URL for serving assets (CloudFront distribution URL)
AWS_CDN_URL=

# DynamoDB Table Names
DYNAMODB_CORE_TABLE=handloom-core
DYNAMODB_ORDERS_TABLE=handloom-orders
DYNAMODB_SESSIONS_TABLE=handloom-sessions
DYNAMODB_AUDIT_TABLE=handloom-audit
DYNAMODB_ANALYTICS_TABLE=handloom-analytics
DYNAMODB_NOTIFICATIONS_TABLE=handloom-notifications

# PostgreSQL Configuration (catalog data: categories, products, inventory)
# All environments use POSTGRES_DSN directly (local Docker or Neon Postgres)
POSTGRES_DSN=postgres://handloom:handloom@localhost:5432/handloom?sslmode=disable

# JWT Configuration
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ACCESS_TOKEN_DURATION=15m
JWT_REFRESH_TOKEN_DURATION=168h
JWT_ISSUER=handloom-admin

# CORS Configuration (comma-separated origins for production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# B2C Store Configuration
# =============================================================================

# PhonePe Standard Checkout
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
PHONEPE_CALLBACK_URL=http://localhost:8081/api/v1/store/webhooks/phonepe
PHONEPE_REDIRECT_URL=http://localhost:3000/checkout/confirmation
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Delhivery Shipping
DELHIVERY_API_TOKEN=
DELHIVERY_BASE_URL=https://track.delhivery.com
DELHIVERY_CLIENT_NAME=
DELHIVERY_WEBHOOK_TOKEN=
DELHIVERY_PICKUP_LOCATION=Primary
NDR_REATTEMPT_LIMIT=3
RETURN_WINDOW_DAYS=7

# MSG91 SMS/OTP
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_BASE_URL=https://control.msg91.com

# Customer Auth (B2C storefront)
CUSTOMER_JWT_SECRET=dev-customer-secret-change-in-production
CUSTOMER_ACCESS_TOKEN_TTL=15m
CUSTOMER_REFRESH_TOKEN_TTL=168h

# =============================================================================
# Event Bus Configuration
# =============================================================================
# SNS topic ARN for event publishing (used in Lambda mode only)
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:000000000000:handloom-events-local
# Set to true in Lambda mode to enable SNS publishing; false uses LocalPublisher
EVENT_PUBLISHING_ENABLED=false

# =============================================================================
# Default Admin Credentials (created by seed-data script)
# =============================================================================
# Email: admin@handloom.com
# Password: Admin@123!
#
# IMPORTANT: Change these credentials immediately after first login!

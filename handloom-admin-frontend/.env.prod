# Prod environment (cloud) — loaded by `vite build --mode prod`.
# Contains only public URLs. Never put tokens or secrets here.

VITE_API_URL=https://api.homechrome.in
VITE_APP_ENV=production
VITE_APP_NAME='Handloom Admin'

# Neon Auth — issues short-lived JWTs for Neon Data API.
# REPLACE with prod Neon Auth URL when prod project is set up.
VITE_NEON_AUTH_URL=https://ep-royal-dawn-ao5i3och.neonauth.c-2.ap-southeast-1.aws.neon.tech/neondb/auth

# Neon Data API — REST endpoint over the prod Neon project. Client appends /rest/v1/<table>.
# NOTE: apirest host (not neonauth) — the Data API is a different host from Neon Auth.
VITE_NEON_DATA_API_URL=https://ep-royal-dawn-ao5i3och.apirest.c-2.ap-southeast-1.aws.neon.tech/neondb

VITE_DASHBOARD_ALLOWED_EMAIL_DOMAINS=homechrome.in

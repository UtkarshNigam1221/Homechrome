# Prod environment (cloud) — loaded by `vite build --mode prod`.
# Contains only public URLs. Never put tokens or secrets here.

VITE_API_URL=https://api.homechrome.in
VITE_APP_ENV=production
VITE_APP_NAME=Handloom Admin

# Neon Auth — issues short-lived JWTs for Neon Data API.
# REPLACE with prod Neon Auth URL when prod project is set up.
VITE_NEON_AUTH_URL=

# Neon Data API — REST endpoint over the prod Neon project.
# REPLACE with prod Data API URL when prod project is set up.
VITE_NEON_DATA_API_URL=

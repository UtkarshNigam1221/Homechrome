# Local dev — Vite proxies /admin/* to LocalStack Lambda (port 4566).
# Loaded by `vite --mode local-lambda` (`npm run dev:lambda`).

VITE_API_URL=
VITE_APP_ENV=development
VITE_APP_NAME=Handloom Admin (local-lambda)

# Neon Auth + Data API — same as dev cloud.
VITE_NEON_AUTH_URL=https://ep-withered-wildflower-a1w1j0p1.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://ep-withered-wildflower-a1w1j0p1.apirest.ap-southeast-1.aws.neon.tech/neondb/rest/v1

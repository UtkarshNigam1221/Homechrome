# API URL (leave empty for local dev with Vite proxy)
VITE_API_URL=
VITE_APP_ENV=development
VITE_APP_NAME=Handloom Admin

# Neon Auth (Better Auth) — separate login alongside admin auth.
# Used ONLY to mint short-lived JWTs for Neon Data API requests.
# Existing admin custom-JWT auth is unaffected.
VITE_NEON_AUTH_URL=https://ep-withered-wildflower-a1w1j0p1.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth

# Neon Data API (REST over Postgres, used by dashboards)
# Provision via Neon Console → Data API. JWT minted by Neon Auth (above),
# scoped via RLS to `metrics_viewer` role. Leave blank locally — dashboards will warn + skip.
VITE_NEON_DATA_API_URL=https://ep-withered-wildflower-a1w1j0p1.apirest.ap-southeast-1.aws.neon.tech/neondb/rest/v1

# Dashboard access allowlist — comma-separated email domains permitted past the
# Neon Auth (Google) gate. Neon Auth accepts ANY Google account, so this is the
# control that keeps analytics restricted to staff. Defaults to homechrome.in
# if unset. Fails closed: an email outside the list is rejected.
VITE_DASHBOARD_ALLOWED_EMAIL_DOMAINS=homechrome.in

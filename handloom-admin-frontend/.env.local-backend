# Local dev — Vite proxies /admin/* to localhost:8081 (monolith backend).
# Loaded by `vite --mode local-backend` (`npm run dev:local`).

VITE_API_URL=
VITE_APP_ENV=development
VITE_APP_NAME=Handloom Admin (local)


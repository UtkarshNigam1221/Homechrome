# Dev environment (cloud) — loaded by `vite build --mode dev`.
# Contains only public URLs. Never put tokens or secrets here.

VITE_API_URL=https://dev-api.homechrome.in
VITE_APP_ENV=development
VITE_APP_NAME='Handloom Admin (dev)'

# Neon Auth — issues short-lived JWTs for Neon Data API.
VITE_NEON_AUTH_URL=https://ep-withered-wildflower-a1w1j0p1.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth

# Neon Data API — REST endpoint over the dev Neon project. Client appends /rest/v1/<table>.
VITE_NEON_DATA_API_URL=https://ep-withered-wildflower-a1w1j0p1.apirest.ap-southeast-1.aws.neon.tech/neondb

# Dashboard access allowlist. Domains for staff; exact emails for personal accounts.
VITE_DASHBOARD_ALLOWED_EMAIL_DOMAINS=homechrome.in
VITE_DASHBOARD_ALLOWED_EMAILS=utkarshnigam1221@gmail.com,sunilbatrahpr@gmail.com

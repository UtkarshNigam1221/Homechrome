# =============================================================================
# Homechrome Store - Environment Configuration
# =============================================================================
# Copy this file to .env.local and modify as needed for local development

# Backend API URL (used for server-side fetches and Next.js API rewrites)
NEXT_PUBLIC_API_URL=http://localhost:8081

# Public site URL (used for SEO, sitemap generation, and meta tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

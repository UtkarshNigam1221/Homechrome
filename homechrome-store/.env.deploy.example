# homechrome-store/.env.deploy.{dev,prod}
#
# Deploy-time env vars sourced by cdk:{synth,deploy}:{dev,prod} npm
# scripts. NOT Next.js runtime config (those use .env.local etc).
#
# Copy to .env.deploy.dev / .env.deploy.prod and fill in real values.
# .env.deploy.* (except *.example) is gitignored.

# AWS region for cdk deploy.
AWS_REGION=ap-south-1

# Public URLs baked into the Next.js build via NEXT_PUBLIC_* convention.
# Change per env.
NEXT_PUBLIC_API_URL=https://dev-api.homechrome.in
NEXT_PUBLIC_SITE_URL=https://dev-store.homechrome.in

# Community-published ADOT OTel Collector Lambda layer ARN.
# See https://github.com/open-telemetry/opentelemetry-lambda/releases
# Format: arn:aws:lambda:{region}:184161586896:layer:opentelemetry-collector-{arch}-{version}:N
OTEL_COLLECTOR_LAYER_ARN=arn:aws:lambda:ap-south-1:184161586896:layer:opentelemetry-collector-arm64-0_22_0:1

# Node.js auto-instrumentation Lambda layer.
# Same publisher (184161586896). Wraps the Node runtime so OpenTelemetry
# spans + metrics are emitted without any app-side SDK code. Required for
# Next.js Server Lambda — we removed instrumentation.ts to avoid OpenNext
# packaging issues with Next.js 16.
# See https://github.com/open-telemetry/opentelemetry-lambda/releases
NODE_AUTO_INSTR_LAYER_ARN=arn:aws:lambda:ap-south-1:184161586896:layer:opentelemetry-nodejs-0_22_0:1

# AWS SSM parameter names for Grafana Cloud OTLP endpoint + auth.
# Provisioned out-of-band; see docs/observability/grafana-cloud-setup.md.
# Both are plain SSM `String` (NOT SecureString — CFN forbids
# {{resolve:ssm-secure:...}} in Lambda env vars).
GRAFANA_ENDPOINT_SSM_PARAM=/handloom/dev/grafana-otlp-endpoint
GRAFANA_AUTH_SSM_PARAM=/handloom/dev/grafana-otlp-auth
